@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Serif:ital,wght@0,600;1,500&display=swap');

:root {
  --ink: #1b2420;
  --paper: #eef1ea;
  --paper-2: #e2e7db;
  --line: #c7cfbd;
  --temp: #c1502e;
  --temp-soft: #e8d4c8;
  --humid: #2e6f8e;
  --humid-soft: #cfe0e6;
  --mono: 'IBM Plex Mono', 'Courier New', monospace;
  --sans: 'IBM Plex Sans', system-ui, sans-serif;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--paper);
  background-image:
    linear-gradient(var(--line) 1px, transparent 1px),
    linear-gradient(90deg, var(--line) 1px, transparent 1px);
  background-size: 28px 28px;
  background-position: -1px -1px;
  color: var(--ink);
  font-family: var(--sans);
  min-height: 100vh;
  padding: 20px 16px 60px;
}

.wrap {
  max-width: 920px;
  margin: 0 auto;
}

header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  flex-wrap: wrap;
  gap: 16px;
  border-bottom: 2px solid var(--ink);
  padding-bottom: 14px;
  margin-bottom: 22px;
}

.brand-eyebrow {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: #5b6559;
}

h1 {
  font-family: 'IBM Plex Serif', serif;
  font-style: italic;
  font-weight: 600;
  font-size: clamp(28px, 5vw, 40px);
  margin: 2px 0 0;
  letter-spacing: -0.01em;
}

.status {
  text-align: right;
  font-family: var(--mono);
  font-size: 12px;
  color: #5b6559;
}

.status .dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #3f8a52;
  margin-right: 6px;
  box-shadow: 0 0 0 0 rgba(63, 138, 82, .6);
  animation: pulse 2s infinite;
}

.status .dot.off {
  background: #b23c3c;
  animation: none;
}

@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(63, 138, 82, .5); }
  70% { box-shadow: 0 0 0 8px rgba(63, 138, 82, 0); }
  100% { box-shadow: 0 0 0 0 rgba(63, 138, 82, 0); }
}

.readings {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-bottom: 16px;
}

@media (max-width: 560px) {
  .readings { grid-template-columns: 1fr; }
}

.card {
  background: #f7f8f3;
  border: 1.5px solid var(--ink);
  padding: 20px 22px;
  position: relative;
  box-shadow: 4px 4px 0 rgba(27, 36, 32, 0.08);
}

.card .tag {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: #5b6559;
  display: flex;
  justify-content: space-between;
}

.card .value-row {
  display: flex;
  align-items: baseline;
  gap: 6px;
  margin-top: 10px;
}

.card .value {
  font-family: 'IBM Plex Serif', serif;
  font-weight: 600;
  font-size: 56px;
  line-height: 1;
}

.card.temp .value { color: var(--temp); }
.card.humid .value { color: var(--humid); }

.card .unit {
  font-family: var(--mono);
  font-size: 18px;
  color: #5b6559;
}

.card .bar-track {
  margin-top: 16px;
  height: 8px;
  background: var(--line);
  position: relative;
  overflow: hidden;
}

.card .bar-fill {
  height: 100%;
  transition: width .6s ease;
}

.card.temp .bar-fill { background: var(--temp); }
.card.humid .bar-fill { background: var(--humid); }

.card .range-labels {
  display: flex;
  justify-content: space-between;
  font-family: var(--mono);
  font-size: 10px;
  color: #8a9285;
  margin-top: 4px;
}

.card .note {
  margin-top: 14px;
  font-size: 12.5px;
  color: #454e42;
  border-top: 1px dashed var(--line);
  padding-top: 10px;
  min-height: 34px;
}

.chart-card {
  background: #f7f8f3;
  border: 1.5px solid var(--ink);
  padding: 20px 22px;
  box-shadow: 4px 4px 0 rgba(27, 36, 32, 0.08);
  margin-bottom: 16px;
}

.chart-card .tag {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: #5b6559;
  margin-bottom: 12px;
  display: flex;
  justify-content: space-between;
}

.chart-wrap {
  height: 240px;
}

.footer-strip {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8px;
  font-family: var(--mono);
  font-size: 11px;
  color: #5b6559;
  border-top: 1.5px solid var(--ink);
  padding-top: 12px;
}

.legend-dot {
  display: inline-block;
  width: 9px;
  height: 9px;
  margin-right: 5px;
}

.legend-dot.temp { background: var(--temp); }
.legend-dot.humid { background: var(--humid); }
