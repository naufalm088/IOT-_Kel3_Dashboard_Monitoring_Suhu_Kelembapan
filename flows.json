        "id": "46bf70c3afb447eb",
        "type": "function",
        "z": "138738df0e783aee",
        "name": "Simulasi DHT",
        "func": "let baseTemp = 28;\nlet baseHumidity = 70;\n\nlet temperature = +(baseTemp + (Math.random() * 4 - 2)).toFixed(1);\nlet humidity = +(baseHumidity + (Math.random() * 10 - 5)).toFixed(1);\n\ntemperature = Math.max(20, Math.min(35, temperature));\nhumidity = Math.max(40, Math.min(95, humidity));\n\nmsg.payload = {\n    temperature: temperature,\n    humidity: humidity,\n    timestamp: new Date().toISOString()\n};\n\n// simpan ke global context biar bisa diakses endpoint API\nglobal.set('latestSensorData', msg.payload);\n\nreturn msg;",
